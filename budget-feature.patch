@@ -0,0 +1,131 @@
+package main;
+
+import java.awt.Color;
+import java.awt.Font;
+import java.time.YearMonth;
+import java.util.List;
+
+import javax.swing.DefaultListModel;
+import javax.swing.JButton;
+import javax.swing.JLabel;
+import javax.swing.JList;
+import javax.swing.JPanel;
+import javax.swing.JScrollPane;
+import javax.swing.SwingConstants;
+import javax.swing.border.LineBorder;
+
+// Shows the signed-in user's budgets for a given month: the limit set per category,
+// how much has actually been spent (read from transactions.txt), and whether they're
+// over budget. Lets the user add/edit a budget via BudgetForm, or copy last month's
+// budgets forward.
+public class BudgetPanel extends JPanel {
+
+	private static final long serialVersionUID = 1L;
+
+	private final CurrentUser user;
+	private final BudgetService budgetService = new BudgetService();
+	private final BudgetController budgetController;
+
+	private YearMonth selectedMonth = YearMonth.now();
+
+	private JLabel monthLabel;
+	private DefaultListModel<String> listModel;
+	private JList<String> budgetList;
+
+	public BudgetPanel(CurrentUser user) {
+		this.user = user;
+		this.budgetController = new BudgetController(user, this);
+
+		this.setBounds(getVisibleRect());
+		this.setBorder(new LineBorder(new Color(0, 0, 0), 2));
+		this.setLayout(null);
+
+		JLabel title = new JLabel("Budget Tracker", SwingConstants.CENTER);
+		title.setFont(title.getFont().deriveFont(Font.BOLD, 18f));
+		title.setBounds(20, 10, 500, 25);
+		this.add(title);
+
+		JButton prevMonth = new JButton("<");
+		prevMonth.setBounds(30, 45, 40, 27);
+		prevMonth.setFocusable(false);
+		prevMonth.addActionListener(e -> changeMonth(-1));
+		this.add(prevMonth);
+
+		monthLabel = new JLabel(formatMonth(selectedMonth), SwingConstants.CENTER);
+		monthLabel.setFont(monthLabel.getFont().deriveFont(Font.BOLD, 16f));
+		monthLabel.setBounds(75, 45, 200, 27);
+		this.add(monthLabel);
+
+		JButton nextMonth = new JButton(">");
+		nextMonth.setBounds(280, 45, 40, 27);
+		nextMonth.setFocusable(false);
+		nextMonth.addActionListener(e -> changeMonth(1));
+		this.add(nextMonth);
+
+		JButton addBudgetButton = new JButton("Add Budget");
+		addBudgetButton.setBounds(340, 45, 130, 27);
+		addBudgetButton.setFocusable(false);
+		addBudgetButton.addActionListener(e -> openBudgetForm());
+		this.add(addBudgetButton);
+
+		JButton copyLastMonthButton = new JButton("Copy Last Month");
+		copyLastMonthButton.setBounds(30, 82, 150, 27);
+		copyLastMonthButton.setFocusable(false);
+		copyLastMonthButton.addActionListener(e -> budgetController.onCopyFromLastMonth());
+		this.add(copyLastMonthButton);
+
+		listModel = new DefaultListModel<>();
+		budgetList = new JList<>(listModel);
+		JScrollPane scrollPane = new JScrollPane(budgetList);
+		scrollPane.setBounds(30, 120, 485, 265);
+		this.add(scrollPane);
+
+		refreshUI();
+	}
+
+	private void changeMonth(int delta) {
+		selectedMonth = selectedMonth.plusMonths(delta);
+		refreshUI();
+	}
+
+	private void openBudgetForm() {
+		BudgetForm form = new BudgetForm(user, budgetController, selectedMonth);
+		form.setVisible(true);
+	}
+
+	// re-reads budgets.txt/transactions.txt for the selected month and redraws the list.
+	// called after adding a budget, changing the month, or copying last month's budgets.
+	public void refreshUI() {
+		monthLabel.setText(formatMonth(selectedMonth));
+		listModel.clear();
+
+		List<Budget> budgets = budgetService.getBudgetsForMonth(user, selectedMonth);
+		if (budgets.isEmpty()) {
+			listModel.addElement("No budgets set for " + formatMonth(selectedMonth) + " yet.");
+		} else {
+			for (Budget budget : budgets) {
+				BudgetStatus status = budgetService.getBudgetStatus(budget, user);
+				listModel.addElement(formatBudgetLine(status));
+			}
+		}
+
+		revalidate();
+		repaint();
+	}
+
+	private String formatBudgetLine(BudgetStatus status) {
+		Budget budget = status.getBudget();
+		String flag = status.isOverBudget() ? "  [OVER BUDGET]" : "";
+		return String.format("%s: $%.2f spent of $%.2f limit ($%.2f remaining)%s", budget.getCategory(),
+				status.getSpent(), budget.getMonthlyLimit(), status.getRemaining(), flag);
+	}
+
+	private String formatMonth(YearMonth month) {
+		return month.getMonth().toString().charAt(0) + month.getMonth().toString().substring(1).toLowerCase()
+				+ " " + month.getYear();
+	}
+
+	public YearMonth getSelectedMonth() {
+		return selectedMonth;
+	}
+}
