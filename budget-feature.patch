+
+// Service layer
 public class BudgetService {
-	public void setBudget() {
-		
+
+	// saves (or overwrites, if one already exists for the same category + month) a budget
+	// to the user's budgets.txt file
+	public void setBudget(Budget budget, CurrentUser user) {
+		String username = user.getUsername();
+		File dir = new File("files/" + username);
+		if (!dir.exists()) {
+			dir.mkdirs();
+		}
+
+		String filePath = "files/" + username + "/budgets.txt";
+		List<Budget> existing = getBudgetsForUser(user);
+
+		boolean replaced = false;
+		for (int i = 0; i < existing.size(); i++) {
+			Budget b = existing.get(i);
+			if (b != null && b.getCategory().equals(budget.getCategory())
+					&& b.getMonth().equals(budget.getMonth())) {
+				existing.set(i, budget);
+				replaced = true;
+				break;
+			}
+		}
+		if (!replaced) {
+			existing.add(budget);
+		}
+
+		try (BufferedWriter writer = new BufferedWriter(new FileWriter(filePath))) {
+			for (Budget b : existing) {
+				if (b != null) {
+					writer.write(b.toString());
+					writer.newLine();
+				}
+			}
+		} catch (IOException e) {
+			System.out.println("Could not write budgets.txt.");
+			e.printStackTrace();
+		}
+	}
+
+	// reads every budget line saved for this user, across all months
+	public List<Budget> getBudgetsForUser(CurrentUser user) {
+		List<Budget> budgets = new ArrayList<>();
+		String username = user.getUsername();
+		File f = new File("files/" + username + "/budgets.txt");
+
+		try (Scanner reader = new Scanner(f)) {
+			while (reader.hasNextLine()) {
+				String line = reader.nextLine();
+				if (!line.isBlank()) {
+					Budget budget = parseBudgetLine(line);
+					if (budget != null) {
+						budgets.add(budget);
+					}
+				}
+			}
+		} catch (FileNotFoundException e) {
+			// no budgets saved yet, that's fine
+		}
+
+		return budgets;
+	}
+
+	// only the budgets that apply to the given month
+	public List<Budget> getBudgetsForMonth(CurrentUser user, YearMonth month) {
+		List<Budget> budgets = new ArrayList<>();
+		for (Budget b : getBudgetsForUser(user)) {
+			if (b.getMonth().equals(month)) {
+				budgets.add(b);
+			}
+		}
+		return budgets;
+	}
+
+	// sums up all EXPENSE transactions in the given category for the given month,
+	// reading the same transactions.txt file FinancePanel/TransactionService use
+	public double getSpentByCategory(CurrentUser user, String category, YearMonth month) {
+		double spent = 0.0;
+		String username = user.getUsername();
+		File f = new File("files/" + username + "/transactions.txt");
+
+		try (Scanner reader = new Scanner(f)) {
+			while (reader.hasNextLine()) {
+				String line = reader.nextLine();
+				if (line.isBlank()) {
+					continue;
+				}
+				// format: id | userId | TYPE | amount | category | description | date | createdAt
+				String[] parts = line.split("\\s*\\|\\s*");
+				if (parts.length < 7) {
+					continue;
+				}
+				try {
+					String type = parts[2];
+					double amount = Double.parseDouble(parts[3]);
+					String txCategory = parts[4];
+					YearMonth txMonth = YearMonth.parse(parts[6].substring(0, 7));
+
+					if (type.equals("EXPENSE") && txCategory.equals(category) && txMonth.equals(month)) {
+						spent += amount;
+					}
+				} catch (Exception e) {
+					// skip malformed lines instead of crashing the whole read
+				}
+			}
+		} catch (FileNotFoundException e) {
+			// no transactions logged yet, that's fine
+		}
+
+		return spent;
+	}
+
+	// convenience bundle of a budget + how it's tracking so far this month
+	public BudgetStatus getBudgetStatus(Budget budget, CurrentUser user) {
+		double spent = getSpentByCategory(user, budget.getCategory(), budget.getMonth());
+		return new BudgetStatus(budget, spent);
+	}
+
+	// parses a single "budgetId | userId | category | monthlyLimit | month | createdAt" line
+	private Budget parseBudgetLine(String line) {
+		String[] parts = line.split("\\s*\\|\\s*");
+		if (parts.length < 6) {
+			return null;
+		}
+		try {
+			String budgetId = parts[0];
+			String userId = parts[1];
+			String category = parts[2];
+			double monthlyLimit = Double.parseDouble(parts[3]);
+			YearMonth month = YearMonth.parse(parts[4]);
+			LocalDateTime createdAt = LocalDateTime.parse(parts[5]);
+			return new Budget(budgetId, userId, category, monthlyLimit, month, createdAt);
+		} catch (Exception e) {
+			// skip malformed lines instead of crashing the whole read
+			System.out.println("Skipping malformed budget line: " + line);
+			return null;
+		}
 	}
-	
-	public void getSpentByCategory() {
-		
+}
+
+// simple read-only pairing of a budget with how much of it has been spent so far;
+// package-private since only one public class is allowed per file
+class BudgetStatus {
+	private final Budget budget;
+	private final double spent;
+
+	BudgetStatus(Budget budget, double spent) {
+		this.budget = budget;
+		this.spent = spent;
 	}
-	
-	public void getBudgetStatus() {
-		
+
+	public Budget getBudget() {
+		return budget;
+	}
+
+	public double getSpent() {
+		return spent;
+	}
+
+	public double getRemaining() {
+		return budget.getRemainingAmount(spent);
+	}
+
+	public boolean isOverBudget() {
+		return budget.isOverBudget(spent);
 	}
 }
