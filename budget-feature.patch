 package main;
 
-// Model layer 
+import java.time.LocalDateTime;
+import java.time.YearMonth;
+
+// Model layer
 public class Budget {
-	// getters/setters, getRemainingAmount(), isOverBudget()
+	/*
+	 * budgetId: String -> unique identifier auto-generated on creation
+	 * userId: String -> links the budget to the authenticated user
+	 * category: String -> the EXPENSE category this budget limit applies to
+	 * monthlyLimit: double -> the max amount the user wants to spend on this category this month
+	 * month: YearMonth -> the month/year this budget applies to
+	 * createdAt: LocalDateTime -> timestamp when the record was created in the system
+	 */
+	String budgetId;
+	String userId;
+	String category;
+	double monthlyLimit;
+	YearMonth month;
+	LocalDateTime createdAt;
+
+	// used when creating a brand new budget from the form
+	public Budget(String userId, String category, double monthlyLimit, YearMonth month) {
+		// create hash based on timestamp of LocalDateTime.now() for it to be unique,
+		// same approach Transaction.java uses for its id
+		int hash = LocalDateTime.now().hashCode();
+		this.budgetId = Integer.toString(hash);
+		this.userId = userId;
+		this.category = category;
+		this.monthlyLimit = monthlyLimit;
+		this.month = month;
+		this.createdAt = LocalDateTime.now();
+	}
+
+	// used when reconstructing a budget read back from budgets.txt
+	public Budget(String budgetId, String userId, String category, double monthlyLimit, YearMonth month,
+			LocalDateTime createdAt) {
+		this.budgetId = budgetId;
+		this.userId = userId;
+		this.category = category;
+		this.monthlyLimit = monthlyLimit;
+		this.month = month;
+		this.createdAt = createdAt;
+	}
+
+	public String getBudgetId() {
+		return budgetId;
+	}
+
+	// no setter for budgetId because it is a unique identifier
+
+	public String getUserId() {
+		return userId;
+	}
+
+	// no setter for userId because this is linked to the user account and should not be modified
+
+	public String getCategory() {
+		return category;
+	}
+
+	public void setCategory(String newCategory) {
+		category = newCategory;
+	}
+
+	public double getMonthlyLimit() {
+		return monthlyLimit;
+	}
+
+	public void setMonthlyLimit(double newMonthlyLimit) {
+		monthlyLimit = newMonthlyLimit;
+	}
+
+	public YearMonth getMonth() {
+		return month;
+	}
+
+	public void setMonth(YearMonth newMonth) {
+		month = newMonth;
+	}
+
+	public LocalDateTime getCreatedAt() {
+		return createdAt;
+	}
+
+	// no setter for createdAt, since this is a unique timestamp based on when
+	// it was created and should not be modified
+
+	// how much of the monthly limit is left, given what's already been spent in this category
+	public double getRemainingAmount(double spent) {
+		return monthlyLimit - spent;
+	}
+
+	// whether spending in this category has exceeded the monthly limit
+	public boolean isOverBudget(double spent) {
+		return spent > monthlyLimit;
+	}
+
+	@Override
+	public String toString() {
+		return getBudgetId() + " | " + getUserId() + " | " + getCategory() + " | " + getMonthlyLimit() + " | "
+				+ getMonth() + " | " + getCreatedAt();
+	}
 }
